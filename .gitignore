.mypy_cache/

# Generated MuJoCo diagnostics (inspect warnings before cleanup)
MUJOCO_LOG.TXT

# Regenerable scaled workstation scan
models/so101-workstation/assets/

# Machine-local SO-101 camera indices and serial port (so101_cameras output)
models/so101/hardware.json
